{
  "name": "hono-cli-todo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vp dev --host --port 8787",
    "build": "vp build",
    "deploy": "cf deploy",
    "preview": "vp preview --port 8787",
    "check": "vp check --fix",
    "takibi": "hono-takibi",
    "generate": "prisma generate && drizzler -o docs/",
    "local:migrate": "cf d1 migrations apply 00000000000000000000000000000000 --local --persist-to .cloudflare/state --dir migrations --pattern 'migrations/*/migration.sql'",
    "remote:migrate": "cf d1 migrations apply 00000000000000000000000000000000 --dir migrations --pattern 'migrations/*/migration.sql'",
    "typecheck": "cf workers types && vp check",
    "migrate:new": "pnpm generate && drizzle-kit generate --name"
  },
  "dependencies": {
    "@effect/sql-d1": "4.1.4",
    "@hono/zod-openapi": "1.6.3",
    "@paralleldrive/cuid2": "3.3.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.4",
    "hono": "4.13.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "2.6.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.13",
    "@hono/cli": "0.1.11",
    "@pandacss/dev": "2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@pandacss/preset-panda": "2.5.0",
    "@tanstack/react-query-devtools": "5.103.1",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.40",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typespec/http": "1.16.0",
    "@typespec/openapi": "1.16.0",
    "@typespec/openapi3": "1.16.0",
    "@vitejs/plugin-react": "6.1.1",
    "cf": "1.0.0-beta.28",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzler": "0.3.2",
    "hekireki": "0.50.0",
    "hono-takibi": "0.30.0",
    "miniflare": "5.20261109.0-beta",
    "prisma": "7.10.0",
    "vite-plus": "0.3.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.7.0",
      "onFail": "download"
    }
  }
}
